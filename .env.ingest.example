# Copy to .env.ingest and fill in. Never commit the real file.

# Cloudflare account id — dashboard right sidebar, or: npx wrangler whoami
CF_ACCOUNT_ID=

# R2 bucket name (create it in step 2 of the setup)
R2_BUCKET=imagerepo

# R2 API token — R2 > Manage API Tokens > Create (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Worker admin endpoint. Leave blank until Phase 2; the CLI works without it.
ADMIN_API_URL=
ADMIN_TOKEN=

# Cloudflare Access service token — required once Access fronts the Worker.
# Zero Trust > Access > Service Auth > Create Service Token
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
