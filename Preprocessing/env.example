# Copy to .env (gitignored) and fill in. Never commit the filled-in copy.

# The Worker, reached through Cloudflare Access with the service token below.
WORKER_URL=https://imagerepo-api.baskaran-sakthivel.workers.dev

# Zero Trust > Access > Service credentials: the imagerepo-preprocessing token.
# Its Client ID must match PREPROCESS_CLIENT_ID in packages/worker/wrangler.toml.
CF_ACCESS_CLIENT_ID=f8a11cca1d8a58058eb47501f1243d1f.access
CF_ACCESS_CLIENT_SECRET=

# R2 > Manage API tokens: Object Read & Write on the imagerepo bucket.
R2_ACCOUNT_ID=7285e6ee853898a8530a2d5887941352
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=imagerepo

# Shown in the Worker's records of who processed what.
RUNNER_NAME=laptop
# Files processed at once; defaults to the number of CPU cores.
# CONCURRENCY=4
# What this machine takes: photo, video, or both (video needs ffmpeg).
KINDS=photo
# EXIF times with no timezone of their own are read in this zone.
PHOTO_TZ=Asia/Singapore
